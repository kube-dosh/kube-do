cluster:
  name: {{ cluster_name }}

k8sServiceHost: {{ control_plane_vip }}
k8sServicePort: {{ control_plane_api_port }}
kubeProxyReplacement: "true"

ipam:
  mode: cluster-pool
  operator:
    clusterPoolIPv4PodCIDRList:
      - {{ pod_cidr }}
    clusterPoolIPv4MaskSize: 24

routingMode: tunnel
tunnelProtocol: vxlan
ipv4:
  enabled: true
ipv6:
  enabled: false

image:
  repository: {{ kube_do_cilium_image.repository }}
  tag: {{ kube_do_cilium_image.tag }}
  useDigest: false
  pullPolicy: IfNotPresent

operator:
  image:
    repository: {{ kube_do_operator_image.repository }}
    tag: {{ kube_do_operator_image.tag }}
    useDigest: false
  replicas: 2

envoy:
  image:
    repository: {{ kube_do_envoy_image.repository }}
    tag: {{ kube_do_envoy_image.tag }}
    useDigest: false

hubble:
  enabled: true
  peerService:
    clusterDomain: {{ cluster_domain }}
  relay:
    enabled: true
    image:
      repository: {{ kube_do_relay_image.repository }}
      tag: {{ kube_do_relay_image.tag }}
      useDigest: false
  ui:
    enabled: false

certgen:
  image:
    repository: {{ kube_do_certgen_image.repository }}
    tag: {{ kube_do_certgen_image.tag }}
    useDigest: false

preflight:
  enabled: false

