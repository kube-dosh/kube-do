global
  log stdout format raw local0
  maxconn 20000
  stats socket /run/haproxy/admin.sock mode 660 level admin

defaults
  mode tcp
  log global
  option tcplog
  timeout connect 5s
  timeout client 1h
  timeout server 1h

frontend kube-apiserver
  bind *:{{ control_plane_api_port }}
  default_backend kube_apiserver_backend

backend kube_apiserver_backend
  balance roundrobin
  option tcp-check
{% for node in control_plane_nodes %}
  server {{ node.name }} {{ node.address }}:6443 check inter 2s fall 3 rise 2
{% endfor %}

