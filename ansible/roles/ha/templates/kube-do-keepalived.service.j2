[Unit]
Description=kube-do keepalived VRRP container
After=network-online.target containerd.service kube-do-haproxy.service
Wants=network-online.target containerd.service kube-do-haproxy.service
Requires=containerd.service

[Service]
Type=simple
RuntimeDirectory=keepalived
RuntimeDirectoryMode=0755
ExecStart=/usr/local/libexec/kube-do-keepalived
ExecStop=-/usr/local/bin/ctr --namespace kube-do task kill --signal TERM keepalived
ExecStopPost=-/usr/local/bin/ctr --namespace kube-do task delete --force keepalived
ExecStopPost=-/usr/local/bin/ctr --namespace kube-do containers delete keepalived
Restart=always
RestartSec=3
TimeoutStartSec=120
TimeoutStopSec=20
KillMode=process

[Install]
WantedBy=multi-user.target
