[Unit]
Description=kube-do HAProxy API load balancer container
After=network-online.target containerd.service
Wants=network-online.target containerd.service
Requires=containerd.service

[Service]
Type=simple
RuntimeDirectory=haproxy
RuntimeDirectoryMode=0755
ExecStart=/usr/local/libexec/kube-do-haproxy
ExecStop=-/usr/local/bin/ctr --namespace kube-do task kill --signal TERM haproxy
ExecStopPost=-/usr/local/bin/ctr --namespace kube-do task delete --force haproxy
ExecStopPost=-/usr/local/bin/ctr --namespace kube-do containers delete haproxy
Restart=always
RestartSec=3
TimeoutStartSec=120
TimeoutStopSec=20
KillMode=process
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
