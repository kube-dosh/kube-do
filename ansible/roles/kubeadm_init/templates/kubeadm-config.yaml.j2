apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
timeouts:
  controlPlaneComponentHealthCheck: {{ kube_do_kubeadm_control_plane_health_timeout }}
  etcdAPICall: {{ kube_do_kubeadm_etcd_api_timeout }}
  kubeletHealthCheck: {{ kube_do_kubeadm_kubelet_health_timeout }}
  kubernetesAPICall: {{ kube_do_kubeadm_kubernetes_api_timeout }}
localAPIEndpoint:
  advertiseAddress: {{ kube_do_node_ip }}
  bindPort: 6443
nodeRegistration:
  name: {{ inventory_hostname }}
  criSocket: unix:///run/containerd/containerd.sock
  imagePullPolicy: IfNotPresent
  kubeletExtraArgs:
    - name: node-ip
      value: {{ kube_do_node_ip }}
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
clusterName: {{ cluster_name }}
kubernetesVersion: {{ kubernetes_version }}
controlPlaneEndpoint: {{ control_plane_address }}
imageRepository: {{ registry_address }}/{{ registry_namespace }}
networking:
  podSubnet: {{ pod_cidr }}
  serviceSubnet: {{ service_cidr }}
  dnsDomain: {{ cluster_domain }}
apiServer:
  certSANs:
    - {{ control_plane_vip }}
{% for node in control_plane_nodes %}
    - {{ node.name }}
    - {{ node.address }}
{% endfor %}
{% if kube_do_kubeadm_apiserver_storage_initialization_timeout or kube_do_kubeadm_apiserver_etcd_healthcheck_timeout or kube_do_kubeadm_apiserver_etcd_readycheck_timeout %}
  extraArgs:
{% if kube_do_kubeadm_apiserver_storage_initialization_timeout %}
    - name: storage-initialization-timeout
      value: "{{ kube_do_kubeadm_apiserver_storage_initialization_timeout }}"
{% endif %}
{% if kube_do_kubeadm_apiserver_etcd_healthcheck_timeout %}
    - name: etcd-healthcheck-timeout
      value: "{{ kube_do_kubeadm_apiserver_etcd_healthcheck_timeout }}"
{% endif %}
{% if kube_do_kubeadm_apiserver_etcd_readycheck_timeout %}
    - name: etcd-readycheck-timeout
      value: "{{ kube_do_kubeadm_apiserver_etcd_readycheck_timeout }}"
{% endif %}
{% endif %}
dns:
  imageRepository: {{ registry_address }}/{{ registry_namespace }}/coredns
  imageTag: {{ kube_do_coredns_image.tag }}
etcd:
  local:
    imageRepository: {{ registry_address }}/{{ registry_namespace }}
    imageTag: {{ kube_do_etcd_image.tag }}
{% if kube_do_kubeadm_etcd_heartbeat_interval or kube_do_kubeadm_etcd_election_timeout or kube_do_kubeadm_etcd_unsafe_no_fsync %}
    extraArgs:
{% if kube_do_kubeadm_etcd_heartbeat_interval %}
      - name: heartbeat-interval
        value: "{{ kube_do_kubeadm_etcd_heartbeat_interval }}"
{% endif %}
{% if kube_do_kubeadm_etcd_election_timeout %}
      - name: election-timeout
        value: "{{ kube_do_kubeadm_etcd_election_timeout }}"
{% endif %}
{% if kube_do_kubeadm_etcd_unsafe_no_fsync %}
      - name: unsafe-no-fsync
        value: "true"
{% endif %}
{% endif %}
{% if kube_do_kubeadm_controller_manager_leader_elect_lease_duration %}
controllerManager:
  extraArgs:
    - name: leader-elect-lease-duration
      value: "{{ kube_do_kubeadm_controller_manager_leader_elect_lease_duration }}"
    - name: leader-elect-renew-deadline
      value: "{{ kube_do_kubeadm_controller_manager_leader_elect_renew_deadline }}"
    - name: leader-elect-retry-period
      value: "{{ kube_do_kubeadm_controller_manager_leader_elect_retry_period }}"
{% endif %}
{% if kube_do_kubeadm_scheduler_leader_elect_lease_duration %}
scheduler:
  extraArgs:
    - name: leader-elect-lease-duration
      value: "{{ kube_do_kubeadm_scheduler_leader_elect_lease_duration }}"
    - name: leader-elect-renew-deadline
      value: "{{ kube_do_kubeadm_scheduler_leader_elect_renew_deadline }}"
    - name: leader-elect-retry-period
      value: "{{ kube_do_kubeadm_scheduler_leader_elect_retry_period }}"
{% endif %}
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: {{ kube_do_kubelet_cgroup_driver }}
failSwapOn: true
runtimeRequestTimeout: {{ kube_do_kubelet_runtime_request_timeout }}
syncFrequency: {{ kube_do_kubelet_sync_frequency }}
fileCheckFrequency: {{ kube_do_kubelet_file_check_frequency }}
nodeStatusUpdateFrequency: {{ kube_do_kubelet_node_status_update_frequency }}
nodeStatusReportFrequency: {{ kube_do_kubelet_node_status_report_frequency }}

